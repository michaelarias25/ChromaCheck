{
  "configurations": [
    {
      "name": "Arduino Nano (TCS3200)",
      "includePath": [
        "${workspaceFolder}/firmware/**",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/1.8.8/cores/arduino",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/1.8.8/variants/eightanaloginputs",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/1.8.8/variants/standard",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/1.8.8/libraries/EEPROM/src",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/avr/include",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/lib/gcc/avr/7.3.0/include"
      ],
      "forcedInclude": [
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/1.8.8/cores/arduino/Arduino.h"
      ],
      "defines": [
        "ARDUINO=10607",
        "ARDUINO_AVR_NANO",
        "ARDUINO_ARCH_AVR",
        "__AVR_ATmega328P__",
        "F_CPU=16000000L"
      ],
      "compilerPath": "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/bin/avr-g++.exe",
      "compilerArgs": ["-mmcu=atmega328p"],
      "cStandard": "c11",
      "cppStandard": "c++11",
      "intelliSenseMode": "gcc-x86"
    }
  ],
  "version": 4
}
