# Copiar este archivo como .env.local y completar los valores. .env.local no se sube al repositorio.

# Cadena de conexión a PostgreSQL en Neon
DATABASE_URL=postgresql://usuario:contrasena@servidor.neon.tech/basededatos?sslmode=require

# Clave para firmar la cookie de sesión: mínimo 32 caracteres, distinta en cada equipo y entorno.
# Para generar una (64 caracteres hexadecimales):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=reemplazar_por_una_clave_aleatoria_de_al_menos_32_caracteres
